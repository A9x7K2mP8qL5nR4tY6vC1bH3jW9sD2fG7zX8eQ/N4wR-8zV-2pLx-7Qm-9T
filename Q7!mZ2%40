	_G.antiLagConn = workspace.DescendantAdded:Connect(function(ij)
		task.spawn(function()
			if ij:IsA("ForceField") or ij:IsA("Sparkles") or ij:IsA("Smoke") or ij:IsA("Fire") or ij:IsA("Beam") then
				c.Heartbeat:Wait()
