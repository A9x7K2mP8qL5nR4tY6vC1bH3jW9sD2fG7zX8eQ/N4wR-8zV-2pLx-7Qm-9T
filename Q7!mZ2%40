local hh = {
	Target = nil,
	UserId = nil,
	Active = false,
	CharConn = nil,
	Loop = false
}

getgenv().SpectateState = getgenv().SpectateState or {
	SavedUserId = nil,
	IsSpectating = false
}

local function hi()
	if hh.CharConn then
		hh.CharConn:Disconnect()
		hh.CharConn = nil
	end
	hh.Loop = false
	if h.Character then
		local hj = h.Character:FindFirstChildOfClass("Humanoid")
		if hj then
			i.CameraSubject = hj
			i.CameraType = Enum.CameraType.Custom
		end
	end
	hh.Active = false
	hh.Target = nil
	getgenv().SpectateState.IsSpectating = false
end

local function hk()
	if hh.Loop then
		hh.Loop = false
		task.wait(0.01)
	end
	hh.Loop = true
	task.spawn(function()
		while hh.Loop do
			task.wait(0.01)
			if hh.Active and hh.Target then
				local hl = hh.Target.Character
				if hl then
					local hm = hl:FindFirstChildOfClass("Humanoid")
					if hm and i.CameraSubject ~= hm then
						i.CameraSubject = hm
					end
				end
			else
				break
			end
		end
	end)
end

local function hn(ho)
	if not ho then
		if hh.UserId then
			for _, hp in ipairs(a:GetPlayers()) do
				if hp.UserId == hh.UserId then
					ho = hp
					hh.Target = ho
					break
				end
			end
		end
		if not ho and getgenv().SpectateState.SavedUserId then
			for _, hq in ipairs(a:GetPlayers()) do
				if hq.UserId == getgenv().SpectateState.SavedUserId then
					ho = hq
					hh.Target = ho
					hh.UserId = hq.UserId
					break
				end
			end
		end
		if not ho then
			hi()
			return
		end
	end
	hh.UserId = ho.UserId
	hh.Target = ho
	getgenv().SpectateState.SavedUserId = ho.UserId
	if hh.CharConn then
		hh.CharConn:Disconnect()
		hh.CharConn = nil
	end
	local function hr(hs)
		if not hh.Active or hh.UserId ~= ho.UserId then return end
		local ht = hs:WaitForChild("Humanoid", 3)
		if ht and hh.Active and hh.UserId == ho.UserId then
			i.CameraSubject = ht
		end
	end
	if ho.Character then hr(ho.Character) end
	hh.CharConn = ho.CharacterAdded:Connect(function(hu)
		if hh.Active and hh.UserId == ho.UserId then
			hr(hu)
		end
	end)
end

local function hv(hw)
	if not hw then return end
	hh.Active = true
	getgenv().SpectateState.IsSpectating = true
	hh.Target = hw
	hh.UserId = hw.UserId
	getgenv().SpectateState.SavedUserId = hw.UserId
	hn(hw)
	hk()
end

