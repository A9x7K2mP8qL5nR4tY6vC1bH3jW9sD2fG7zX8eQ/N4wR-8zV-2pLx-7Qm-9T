		jd.Text = "Your Damage: "
		je.Text = "Hits To Kill: "
		return
	end
	local jh = el(jg)
	local ji = er(jg)
	local jj = el(h)
	local jk = er(h)
	local jl = "inf"
	if jk > 0 then
		local jm = math.ceil(jh / jk)
