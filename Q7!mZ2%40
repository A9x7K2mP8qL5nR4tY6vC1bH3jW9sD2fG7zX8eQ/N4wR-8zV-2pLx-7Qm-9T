local function dk(dl, dm)
	writefile(dl, table.concat(dm, "\n"))
end

local function dn(do_)
	local dp = {}
	if isfile(do_) then
		for dq in readfile(do_):gmatch("[^\r\n]+") do
			local dr = dq:match("^%s*(.-)%s*$")
			if dr and dr ~= "" then
				table.insert(dp, dr)
			end
		end
	end
	return dp
end

