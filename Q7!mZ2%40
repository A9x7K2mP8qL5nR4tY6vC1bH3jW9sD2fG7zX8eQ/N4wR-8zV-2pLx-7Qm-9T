local function x(y)
	y = math.max(0, math.floor(y))
	return string.format("%dD / %dH / %dM / %dS",
		math.floor(y / 86400),
		math.floor((y % 86400) / 3600),
		math.floor((y % 3600) / 60),
		y % 60)
end

local function z(aa)
	if aa >= 1e15 then return string.format("%.1fqa", aa / 1e15)
	elseif aa >= 1e12 then return string.format("%.1ft", aa / 1e12)
	elseif aa >= 1e9 then return string.format("%.1fb", aa / 1e9)
	elseif aa >= 1e6 then return string.format("%.1fm", aa / 1e6)
	elseif aa >= 1e3 then return string.format("%.1fk", aa / 1e3)
	elseif aa == math.floor(aa) then return tostring(math.floor(aa))
	else return string.format("%.1f", aa) end
end

local function ab(ac)
	local ad = tostring(math.floor(ac))
	while true do
		local ae
		ad, ae = ad:gsub("^(-?%d+)(%d%d%d)", "%1,%2")
		if ae == 0 then break end
	end
	return ad
end

