		elseif jm < 1 then jl = "instant"
		else jl = tostring(jm) end
	end
	ja.Text = string.format("Enemy Health: %s (%s)", z(jh), ab(jh))
	jb.Text = string.format("Enemy Damage: %s (%s)", z(ji), ab(ji))
	jc.Text = string.format("Your Health: %s (%s)", z(jj), ab(jj))
	jd.Text = string.format("Your Damage: %s (%s)", z(jk), ab(jk))
	je.Text = "Hits To Kill: " .. jl
end

