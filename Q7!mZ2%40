local function ee()
	if not h.Character then
		repeat task.wait() until h.Character
	end
	return h.Character
end

local function ef(eg)
	return eg and eg.Character
		and eg.Character:FindFirstChild("HumanoidRootPart")
		and eg.Character:FindFirstChild("Humanoid")
		and eg.Character.Humanoid.Health > 0
end

local function eh()
	for _, ei in pairs(h.Backpack:GetChildren()) do
		if ei.Name == "Punch" and h.Character and h.Character:FindFirstChild("Humanoid") then
			h.Character.Humanoid:EquipTool(ei)
		end
	end
	if h:FindFirstChild("muscleEvent") then
		h.muscleEvent:FireServer("punch", "leftHand")
		h.muscleEvent:FireServer("punch", "rightHand")
	end
end

local function ej(ek)
	if not ef(ek) or not ee():FindFirstChild("LeftHand") then return end
	pcall(function()
		firetouchinterest(ek.Character.HumanoidRootPart, ee().LeftHand, 0)
		firetouchinterest(ek.Character.HumanoidRootPart, ee().LeftHand, 1)
		eh()
	end)
end

local function el(em)
	if not em then return 0 end
	local en = em:FindFirstChild("Durability") or (em:FindFirstChild("leaderstats") and em.leaderstats:FindFirstChild("Durability"))
	if not en then return 0 end
	local eo = 1
	if em:FindFirstChild("ultimatesFolder") and em.ultimatesFolder:FindFirstChild("Infernal Health") then
		eo += 0.15 * (em.ultimatesFolder["Infernal Health"].Value or 0)
	end
	if em:FindFirstChild("equippedPets") then
		for _, ep in ipairs(em.equippedPets:GetChildren()) do
			if ep:IsA("ObjectValue") and ep.Value then
				local eq = string.lower(ep.Value.Name)
				if eq:match("mighty") and eq:match("monster") then eo += 0.5 end
				if eq:match("small") and eq:match("fry") then eo += 0.25 end
			end
		end
	end
	return en.Value * eo
end

local function er(es)
	if not es or not es:FindFirstChild("leaderstats") or not es.leaderstats:FindFirstChild("Strength") then return 0 end
	local et = es.leaderstats.Strength.Value * (1 / 15)
	local eu = 1
	if es:FindFirstChild("ultimatesFolder") and es.ultimatesFolder:FindFirstChild("Demon Damage") then
		eu += 0.1 * (es.ultimatesFolder["Demon Damage"].Value or 0)
	end
	if es:FindFirstChild("equippedPets") then
		for _, ev in ipairs(es.equippedPets:GetChildren()) do
			if ev:IsA("ObjectValue") and ev.Value then
				local ew = string.lower(ev.Value.Name)
				if ew:match("wild") and ew:match("wizard") then eu += 0.5 end
				if ew:match("chaos") and ew:match("sorcerer") then eu += 0.25 end
			end
		end
	end
	return et * eu
end

