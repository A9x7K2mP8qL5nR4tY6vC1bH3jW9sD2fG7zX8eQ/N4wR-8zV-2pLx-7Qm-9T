function af:SelectTab(cg)
	self.Selected = cg
	for ch, ci in ipairs(self.Tabs) do
		ci.Page.Visible = (ch == cg)
		if ch == cg then
			d:Create(ci.Button, TweenInfo.new(0.15), {BackgroundTransparency = 0, BackgroundColor3 = j.Selected, TextColor3 = j.Text}):Play()
		else
			d:Create(ci.Button, TweenInfo.new(0.15), {BackgroundTransparency = 1, TextColor3 = j.SubText}):Play()
		end
	end
	d:Create(self.Indicator, TweenInfo.new(0.18), {Position = UDim2.fromOffset(0, self.TabOffsets[cg] or 10)}):Play()
end

