function bj:SelectTab(dk)
	self.Selected=dk
	for dl,dm in ipairs(self.Tabs)do
		dm.Page.Visible=(dl==dk)
		if dl==dk then
			d:Create(dm.Button,TweenInfo.new(0.15),{BackgroundTransparency=0,BackgroundColor3=i.h,TextColor3=i.i}):Play()
		else
			d:Create(dm.Button,TweenInfo.new(0.15),{BackgroundTransparency=1,TextColor3=i.j}):Play()
		end
	end
	d:Create(self.Indicator,TweenInfo.new(0.18),{Position=UDim2.fromOffset(0,self.TabOffsets[dk] or 10)}):Play()
end

