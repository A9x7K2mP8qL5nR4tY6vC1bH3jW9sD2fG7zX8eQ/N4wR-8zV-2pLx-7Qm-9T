local function x(y)
	y=math.max(0,math.floor(y))
	local z=math.floor(y/86400)
	local ba=math.floor((y%86400)/3600)
	local bb=math.floor((y%3600)/60)
	local bc=y%60
	return string.format("%dD / %dH / %dM / %dS",z,ba,bb,bc)
end

local function bd(be)
	if be>=1e15 then return string.format("%.1fqa",be/1e15)
	elseif be>=1e12 then return string.format("%.1ft",be/1e12)
	elseif be>=1e9 then return string.format("%.1fb",be/1e9)
	elseif be>=1e6 then return string.format("%.1fm",be/1e6)
	elseif be>=1e3 then return string.format("%.1fk",be/1e3)
	elseif be==math.floor(be) then return tostring(math.floor(be))
	else return string.format("%.1f",be) end
end

local function bf(bg)
	local bh=tostring(math.floor(bg))
	local bi
	while true do
		bh,bi=bh:gsub("^(-?%d+)(%d%d%d)","%1,%2")
		if bi==0 then break end
	end
	return bh
end

