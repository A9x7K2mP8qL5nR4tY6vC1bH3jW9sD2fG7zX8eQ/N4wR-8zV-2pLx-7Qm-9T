local killAutoDetect = false
local killTpAutoDetect = false
local blacklistCooldown = {}
local tpListCooldown = {}
local blacklistHits = {}
local tpListHits = {}

KillTab:AddToggle("Kill Auto Detect", function(state)
	killAutoDetect = state
end)

TeleportTab:AddToggle("Kill Tp Auto Detect", function(state)
	killTpAutoDetect = state
end)

do
	local detectRange  = 15
	local requiredHits = 3
	local tolerance    = 0.02
	local damageEvent  = ReplicatedStorage:WaitForChild("rEvents"):FindFirstChild("guiDamageEvent")
	if damageEvent then
		damageEvent.OnClientEvent:Connect(function(kind, target, damage)
			if kind ~= "damageShow" then return end
			if not killAutoDetect and not killTpAutoDetect then return end
			if type(damage) ~= "number" or damage <= 0 then return end
			local localRoot = GetLocalRoot()
			if not localRoot or target ~= localRoot then return end
			local candidates = {}
			for _, player in ipairs(Players:GetPlayers()) do
				if player == LocalPlayer then continue end
				local character = player.Character
				local rootPart = character and character:FindFirstChild("HumanoidRootPart")
				if not rootPart then continue end
				if (rootPart.Position - localRoot.Position).Magnitude > detectRange then continue end
				local estimatedDamage = GetDamage(player)
				if estimatedDamage > 0 then
					table.insert(candidates, {
						player = player,
						diff = math.abs(estimatedDamage - damage)
					})
				end
			end
			if #candidates == 0 then return end
			table.sort(candidates, function(a, b) return a.diff < b.diff end)
			local best = candidates[1]
			local now = tick()
			local function addToBlacklist(player)
				if blacklistCooldown[player] and now - blacklistCooldown[player] < 8 then return end
				if not IsBlacklisted(player) then
					table.insert(_G.blacklistedPlayers, player.Name)
					SaveList(BlacklistFile, _G.blacklistedPlayers)
				end
				blacklistCooldown[player] = now
				blacklistHits = {}
			end
			local function addToTpList(player)
				if tpListCooldown[player] and now - tpListCooldown[player] < 8 then return end
				if not IsInTpList(player) then
					table.insert(_G.tpListedPlayers, player.Name)
					SaveList(TpListFile, _G.tpListedPlayers)
				end
				tpListCooldown[player] = now
				tpListHits = {}
			end
			local function process(player)
				if killAutoDetect then addToBlacklist(player) end
				if killTpAutoDetect then addToTpList(player) end
			end
			if best.diff <= damage * tolerance then
				process(best.player)
				return
			end
			local hasCloseCompetitors = false
			for idx = 2, #candidates do
				if candidates[idx].diff <= best.diff + damage * tolerance then
					hasCloseCompetitors = true
					break
				end
			end
			if killAutoDetect then
				blacklistHits[best.player] = (blacklistHits[best.player] or 0) + 1
				if not hasCloseCompetitors or blacklistHits[best.player] >= requiredHits then
					addToBlacklist(best.player)
				end
			end
			if killTpAutoDetect then
				tpListHits[best.player] = (tpListHits[best.player] or 0) + 1
				if not hasCloseCompetitors or tpListHits[best.player] >= requiredHits then
					addToTpList(best.player)
				end
			end
		end)
	end
end

local Drawing = Drawing or getgenv().Drawing

local function CreateText(size, color)
	local t = Drawing.new("Text")
	t.Visible = false
	t.Center = true
	t.Outline = false
	t.Color = color
	t.Font = Drawing.Fonts.UI
	t.Size = size
	t.Text = ""
	t.ZIndex = 2
	return t
end

local SpecName = CreateText(20, Color3.fromRGB(255, 220, 40))
local SpecHP   = CreateText(17, Color3.fromRGB(255, 255, 255))
local SpecDMG  = CreateText(17, Color3.fromRGB(255, 55, 55))

local NameOutlines, HPOutlines, DMGOutlines = {}, {}, {}

local offsets = {
	Vector2.new(-1.5, -1.5), Vector2.new(0, -1.5), Vector2.new(1.5, -1.5),
	Vector2.new(-1.5,  0), Vector2.new(1.5,  0),
	Vector2.new(-1.5,  1.5), Vector2.new(0,  1.5), Vector2.new(1.5,  1.5),
	Vector2.new(-2, 0), Vector2.new(2, 0), Vector2.new(0, -2), Vector2.new(0, 2)
}

for i = 1, #offsets do
	NameOutlines[i] = CreateText(20, Color3.fromRGB(0, 0, 0))
	HPOutlines[i] = CreateText(17, Color3.fromRGB(0, 0, 0))
	DMGOutlines[i] = CreateText(17, Color3.fromRGB(0, 0, 0))
	NameOutlines[i].ZIndex = 1
	HPOutlines[i].ZIndex = 1
	DMGOutlines[i].ZIndex = 1
end

HideSpectateDrawings = function()
	SpecName.Visible = false
	SpecHP.Visible = false
	SpecDMG.Visible = false
	for i = 1, #offsets do
		NameOutlines[i].Visible = false
		HPOutlines[i].Visible = false
		DMGOutlines[i].Visible = false
	end
end

local function SetTextWithOutline(main, outlines, text, pos)
	main.Text = text
	main.Position = pos
	main.Visible = true
	for i, offset in ipairs(offsets) do
		outlines[i].Text = text
		outlines[i].Position = pos + offset
		outlines[i].Visible = true
	end
end

local function UpdateSpectateDrawings()
	if not SpectateData.Spectating or not SpectateData.SelectedPlayer or not SpectateData.SelectedPlayer.Character then
		HideSpectateDrawings()
		return
	end
	local char = SpectateData.SelectedPlayer.Character
	local head = char:FindFirstChild("Head") or char:FindFirstChild("HumanoidRootPart")
	if not head then
		HideSpectateDrawings()
		return
	end
	local worldPos = head.Position + Vector3.new(0, 3.15, 0)
	local pos, onScreen = Camera:WorldToViewportPoint(worldPos)
	if not onScreen or pos.Z < 0 then
		HideSpectateDrawings()
		return
	end
	local x, y = pos.X, pos.Y
	SetTextWithOutline(SpecName, NameOutlines, SpectateData.SelectedPlayer.DisplayName, Vector2.new(x, y))
	local humanoid = char:FindFirstChildOfClass("Humanoid")
	local current = humanoid and humanoid.Health or 0
	local max = GetHealth(SpectateData.SelectedPlayer)
	SetTextWithOutline(SpecHP, HPOutlines, "HP: " .. FormatNumber(current) .. "/" .. FormatNumber(max), Vector2.new(x, y + 23))
	SetTextWithOutline(SpecDMG, DMGOutlines, "DMG: " .. FormatNumber(GetDamage(SpectateData.SelectedPlayer)), Vector2.new(x, y + 44))
end

