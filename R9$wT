end

local function dt(du)
	local dv={}
	if isfile(du) then
		for dw in readfile(du):gmatch("[^\r\n]+")do
			local dx=dw:match("^%s*(.-)%s*$")
			if dx and dx~="" then
				table.insert(dv,dx)
			end
		end
	end
	return dv
end

