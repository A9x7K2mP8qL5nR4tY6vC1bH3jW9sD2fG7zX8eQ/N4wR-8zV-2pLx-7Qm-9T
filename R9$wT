		if btn.BackgroundTransparency == 1 then
			TweenService:Create(btn, TweenInfo.new(0.12), { BackgroundTransparency = 0, BackgroundColor3 = Theme.SurfaceHover }):Play()
		end
	end)
	btn.MouseLeave:Connect(function()
		if btn.TextColor3 ~= Theme.Text then
			TweenService:Create(btn, TweenInfo.new(0.12), { BackgroundTransparency = 1 }):Play()
		end
	end)
	local page = Create("Frame", {
		Parent = self.Content,
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		Visible = idx == 1,
		BorderSizePixel = 0
	})
	local main = Create("ScrollingFrame", {
		Parent = page,
		Size = UDim2.new(Layout.Split, -6, 1, 0),
		BackgroundTransparency = 1,
		ScrollBarThickness = 3,
		ScrollBarImageColor3 = Theme.Accent,
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		CanvasSize = UDim2.new(),
		BorderSizePixel = 0
	})
	Create("UIListLayout", { Parent = main, Padding = UDim.new(0, 6) })
	Create("UIPadding", { Parent = main, PaddingTop = UDim.new(0, 10), PaddingLeft = UDim.new(0, 10), PaddingRight = UDim.new(0, 6) })
	local side = Create("ScrollingFrame", {
		Parent = page,
		Size = UDim2.new(1 - Layout.Split, -6, 1, 0),
		Position = UDim2.new(Layout.Split, 6, 0, 0),
		BackgroundTransparency = 1,
		ScrollBarThickness = 3,
		ScrollBarImageColor3 = Theme.Accent,
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		CanvasSize = UDim2.new(),
		BorderSizePixel = 0
	})
	Create("UIListLayout", { Parent = side, Padding = UDim.new(0, 6) })
	Create("UIPadding", { Parent = side, PaddingTop = UDim.new(0, 10), PaddingLeft = UDim.new(0, 6), PaddingRight = UDim.new(0, 10) })
	if self._beginDrag then
		for _, f in ipairs({ main, side, page }) do
			f.InputBegan:Connect(self._beginDrag)
			f.InputEnded:Connect(self._endDrag)
		end
	end
	table.insert(self.Tabs, { Button = btn, Page = page })
	table.insert(self.TabOffsets, 10 + (idx - 1) * 34)
	btn.MouseButton1Click:Connect(function()
		self:SelectTab(idx)
	end)
	return setmetatable({ Main = main, Side = side, Page = page, Library = self }, Tab)
end

function Library:SelectTab(idx)
	self.Selected = idx
	for i, tab in ipairs(self.Tabs) do
		tab.Page.Visible = (i == idx)
		if i == idx then
			TweenService:Create(tab.Button, TweenInfo.new(0.15), { BackgroundTransparency = 0, BackgroundColor3 = Theme.AccentDim, TextColor3 = Theme.Text }):Play()
		else
			TweenService:Create(tab.Button, TweenInfo.new(0.15), { BackgroundTransparency = 1, TextColor3 = Theme.TextDim }):Play()
		end
	end
	TweenService:Create(self.Indicator, TweenInfo.new(0.18), { Position = UDim2.fromOffset(0, self.TabOffsets[idx] or 10) }):Play()
end

