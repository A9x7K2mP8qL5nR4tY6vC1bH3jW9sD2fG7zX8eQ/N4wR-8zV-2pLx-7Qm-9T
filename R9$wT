		BorderSizePixel = 0
	})
	Create("UIListLayout", {Parent = side, Padding = UDim.new(0, 7)})
	Create("UIPadding", {
		Parent = side,
		PaddingTop = UDim.new(0, 10),
		PaddingLeft = UDim.new(0, 8),
		PaddingRight = UDim.new(0, 10)
	})
	if self._OnDragStart and self._OnDragEnd then
		main.InputBegan:Connect(self._OnDragStart)
		main.InputEnded:Connect(self._OnDragEnd)
		side.InputBegan:Connect(self._OnDragStart)
		side.InputEnded:Connect(self._OnDragEnd)
		page.InputBegan:Connect(self._OnDragStart)
		page.InputEnded:Connect(self._OnDragEnd)
	end
	table.insert(self.Tabs, {Button = button, Page = page})
	table.insert(self.TabOffsets, 10 + (index - 1) * 34)
	button.MouseButton1Click:Connect(function()
		self:SelectTab(index)
	end)
	return setmetatable({Page = page, Main = main, Side = side, Library = self}, Tab)
end

function Library:SelectTab(index)
	self.SelectedIndex = index
	for i, tab in ipairs(self.Tabs) do
		tab.Page.Visible = (i == index)
		if i == index then
			TweenService:Create(tab.Button, TweenInfo.new(0.15), {
				BackgroundTransparency = 0,
				BackgroundColor3 = Theme.AccentDark,
				TextColor3 = Theme.TextPrimary
			}):Play()
		else
			TweenService:Create(tab.Button, TweenInfo.new(0.15), {
				BackgroundTransparency = 1,
				TextColor3 = Theme.TextSecondary
			}):Play()
		end
	end
	TweenService:Create(self.Indicator, TweenInfo.new(0.18), {
		Position = UDim2.new(0, 0, 0, self.TabOffsets[index] or 10)
	}):Play()
end

