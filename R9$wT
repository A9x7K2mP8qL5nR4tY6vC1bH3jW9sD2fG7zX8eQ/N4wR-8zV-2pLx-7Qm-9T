		accumulator += dt
		if accumulator >= 1 then
			accumulator -= 1
			timerLabel.Text = FormatTime(os.clock() - startTime)
		end
	end)
	local resizeHandle = Create("TextButton", {
		Parent = panel,
		Size = UDim2.new(0, 16, 0, 16),
		Position = UDim2.new(1, -16, 1, -16),
