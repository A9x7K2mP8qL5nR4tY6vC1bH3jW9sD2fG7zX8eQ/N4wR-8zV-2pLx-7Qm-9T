local function er(es)
	if not es then return 0 end
	local et=es:FindFirstChild("Durability") or (es:FindFirstChild("leaderstats") and es.leaderstats:FindFirstChild("Durability"))
	if not et then return 0 end
	local eu=1
	if es:FindFirstChild("ultimatesFolder") and es.ultimatesFolder:FindFirstChild("Infernal Health") then
		eu+=0.15*(es.ultimatesFolder["Infernal Health"].Value or 0)
	end
	if es:FindFirstChild("equippedPets") then
		for _,ev in ipairs(es.equippedPets:GetChildren())do
			if ev:IsA("ObjectValue") and ev.Value then
				local ew=string.lower(ev.Value.Name)
				if ew:match("mighty") and ew:match("monster") then eu+=0.5 end
				if ew:match("small") and ew:match("fry") then eu+=0.25 end
			end
		end
	end
	return et.Value*eu
end

local function ex(ey)
	if not ey or not ey:FindFirstChild("leaderstats") or not ey.leaderstats:FindFirstChild("Strength") then return 0 end
	local ez=ey.leaderstats.Strength.Value*(1/15)
	local fa=1
	if ey:FindFirstChild("ultimatesFolder") and ey.ultimatesFolder:FindFirstChild("Demon Damage") then
		fa+=0.1*(ey.ultimatesFolder["Demon Damage"].Value or 0)
	end
	if ey:FindFirstChild("equippedPets") then
		for _,fb in ipairs(ey.equippedPets:GetChildren())do
			if fb:IsA("ObjectValue") and fb.Value then
