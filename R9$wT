local function z(aa)
	aa=math.max(0,math.floor(aa))
	local ab=math.floor(aa/86400)
	local ac=math.floor((aa%86400)/3600)
	local ad=math.floor((aa%3600)/60)
	local ae=aa%60
	return string.format("%dD / %dH / %dM / %dS",ab,ac,ad,ae)
end

local function af(ag)
	if ag>=1e15 then return string.format("%.1fqa",ag/1e15)
	elseif ag>=1e12 then return string.format("%.1ft",ag/1e12)
	elseif ag>=1e9 then return string.format("%.1fb",ag/1e9)
	elseif ag>=1e6 then return string.format("%.1fm",ag/1e6)
	elseif ag>=1e3 then return string.format("%.1fk",ag/1e3)
	elseif ag==math.floor(ag) then return tostring(math.floor(ag))
	else return string.format("%.1f",ag) end
end

local function ah(ai)
	local aj=tostring(math.floor(ai))
	local ak
	while true do
		aj,ak=aj:gsub("^(-?%d+)(%d%d%d)","%1,%2")
		if ak==0 then break end
	end
	return aj
end

