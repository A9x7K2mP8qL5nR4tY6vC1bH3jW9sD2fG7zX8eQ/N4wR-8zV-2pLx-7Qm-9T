_G.tpListedPlayers    = _G.tpListedPlayers or {}
_G.blacklistedPlayers = _G.blacklistedPlayers or {}
_G.watchlistedPlayers = _G.watchlistedPlayers or {}

local TpListFile    = "TpList_Players.txt"
local BlacklistFile = "Blacklist_Players.txt"
local WatchlistFile = "Watchlist_Clans.txt"

local function SaveList(file, list)
	writefile(file, table.concat(list, "\n"))
end

local function LoadList(file)
	local result = {}
	if isfile(file) then
		local content = readfile(file)
		for line in content:gmatch("[^\r\n]+") do
			local trimmed = line:match("^%s*(.-)%s*$")
			if trimmed and trimmed ~= "" then
				table.insert(result, trimmed)
			end
		end
	end
	return result
end

_G.tpListedPlayers = LoadList(TpListFile)
_G.blacklistedPlayers = LoadList(BlacklistFile)
_G.watchlistedPlayers = LoadList(WatchlistFile)

local function IsInTpList(player)
	for _, name in ipairs(_G.tpListedPlayers) do
		if name:lower() == player.Name:lower() then return true end
	end
	return false
end

local function IsBlacklisted(player)
	for _, name in ipairs(_G.blacklistedPlayers) do
		if name:lower() == player.Name:lower() then return true end
	end
	return false
end

local function IsWatchlisted(player)
	local nameLower = player.Name:lower()
	local displayLower = player.DisplayName:lower()
	for _, word in ipairs(_G.watchlistedPlayers) do
		local wordLower = word:lower()
		if nameLower:find(wordLower, 1, true) or displayLower:find(wordLower, 1, true) then
			return true
		end
	end
	return false
end

local function GetCharacter()
	if not LocalPlayer.Character then
		repeat task.wait() until LocalPlayer.Character
	end
	return LocalPlayer.Character
end

local function IsAlive(player)
	return player
		and player.Character
		and player.Character:FindFirstChild("HumanoidRootPart")
		and player.Character:FindFirstChild("Humanoid")
		and player.Character.Humanoid.Health > 0
end

local function DoPunch()
	for _, tool in pairs(LocalPlayer.Backpack:GetChildren()) do
		if tool.Name == "Punch" and LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Humanoid") then
			LocalPlayer.Character.Humanoid:EquipTool(tool)
		end
	end
	if LocalPlayer:FindFirstChild("muscleEvent") then
		LocalPlayer.muscleEvent:FireServer("punch", "leftHand")
		LocalPlayer.muscleEvent:FireServer("punch", "rightHand")
	end
end

local function KillPlayer(player)
	if not IsAlive(player) or not GetCharacter():FindFirstChild("LeftHand") then return end
	pcall(function()
		firetouchinterest(player.Character.HumanoidRootPart, GetCharacter().LeftHand, 0)
		firetouchinterest(player.Character.HumanoidRootPart, GetCharacter().LeftHand, 1)
		DoPunch()
	end)
end

local function FormatNumber(number)
	if number >= 1e15 then
		return string.format("%.1fqa", number / 1e15)
	elseif number >= 1e12 then
		return string.format("%.1ft", number / 1e12)
	elseif number >= 1e9 then
		return string.format("%.1fb", number / 1e9)
	elseif number >= 1e6 then
		return string.format("%.1fm", number / 1e6)
	elseif number >= 1e3 then
		return string.format("%.1fk", number / 1e3)
	else
		if number == math.floor(number) then
			return tostring(math.floor(number))
		else
			return string.format("%.1f", number)
		end
	end
end

local function CommaNumber(number)
	local str = tostring(math.floor(number))
	local k
	while true do
		str, k = str:gsub("^(-?%d+)(%d%d%d)", "%1,%2")
		if k == 0 then break end
	end
	return str
end

local function GetHealth(player)
	if not player then return 0 end
	local durability = player:FindFirstChild("Durability")
		or (player:FindFirstChild("leaderstats") and player.leaderstats:FindFirstChild("Durability"))
	if not durability then return 0 end

	local multiplier = 1
	if player:FindFirstChild("ultimatesFolder") and player.ultimatesFolder:FindFirstChild("Infernal Health") then
		multiplier = multiplier + 0.15 * (player.ultimatesFolder["Infernal Health"].Value or 0)
	end
	if player:FindFirstChild("equippedPets") then
		for _, pet in ipairs(player.equippedPets:GetChildren()) do
			if pet:IsA("ObjectValue") and pet.Value then
				local petName = string.lower(pet.Value.Name)
				if petName:match("mighty") and petName:match("monster") then multiplier = multiplier + 0.5 end
				if petName:match("small") and petName:match("fry") then multiplier = multiplier + 0.25 end
			end
		end
	end
	return durability.Value * multiplier
end

local function GetDamage(player)
	if not player or not player:FindFirstChild("leaderstats") or not player.leaderstats:FindFirstChild("Strength") then
		return 0
	end
	local base = player.leaderstats.Strength.Value * (1 / 15)
	local multiplier = 1
	if player:FindFirstChild("ultimatesFolder") and player.ultimatesFolder:FindFirstChild("Demon Damage") then
		multiplier = multiplier + 0.1 * (player.ultimatesFolder["Demon Damage"].Value or 0)
	end
	if player:FindFirstChild("equippedPets") then
		for _, pet in ipairs(player.equippedPets:GetChildren()) do
			if pet:IsA("ObjectValue") and pet.Value then
				local petName = string.lower(pet.Value.Name)
				if petName:match("wild") and petName:match("wizard") then multiplier = multiplier + 0.5 end
				if petName:match("chaos") and petName:match("sorcerer") then multiplier = multiplier + 0.25 end
			end
		end
	end
	return base * multiplier
end

