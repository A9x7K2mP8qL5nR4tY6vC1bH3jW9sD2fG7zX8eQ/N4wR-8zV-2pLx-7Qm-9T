	toggleButton.MouseButton1Click:Connect(function()
		if wasDragged then return end
		panelVisible = not panelVisible
		panel.Visible = panelVisible
	end)
	local draggingPanel, panelDragStart, panelStartPos = false, nil, nil
	local resizing, resizeStart, startSize = false, nil, nil
	local function onDragStart(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			draggingPanel = true
			panelDragStart = input.Position
			panelStartPos = panel.Position
		end
	end
	local function onDragEnd(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			draggingPanel = false
		end
	end
	header.InputBegan:Connect(onDragStart)
	header.InputEnded:Connect(onDragEnd)
	sidebar.InputBegan:Connect(onDragStart)
	sidebar.InputEnded:Connect(onDragEnd)
	tabList.InputBegan:Connect(onDragStart)
	tabList.InputEnded:Connect(onDragEnd)
	content.InputBegan:Connect(onDragStart)
	content.InputEnded:Connect(onDragEnd)
	footer.InputBegan:Connect(onDragStart)
	footer.InputEnded:Connect(onDragEnd)
	timerBar.InputBegan:Connect(onDragStart)
	timerBar.InputEnded:Connect(onDragEnd)
	resizeHandle.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			resizing = true
			resizeStart = input.Position
			startSize = panel.Size
		end
	end)
	resizeHandle.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			resizing = false
		end
	end)
	UserInputService.InputChanged:Connect(function(input)
		if input.UserInputType ~= Enum.UserInputType.MouseMovement and input.UserInputType ~= Enum.UserInputType.Touch then return end
		if draggingPanel then
			local delta = input.Position - panelDragStart
			panel.Position = UDim2.new(panelStartPos.X.Scale, panelStartPos.X.Offset + delta.X, panelStartPos.Y.Scale, panelStartPos.Y.Offset + delta.Y)
		elseif resizing then
			local delta = input.Position - resizeStart
			local newWidth  = math.max(MinWidth, startSize.X.Offset + delta.X)
			local newHeight = math.max(MinHeight, startSize.Y.Offset + delta.Y)
			panel.Size = UDim2.new(startSize.X.Scale, newWidth, startSize.Y.Scale, newHeight)
		elseif draggingToggle then
			local delta = input.Position - dragStart
			if math.abs(delta.X) > 3 or math.abs(delta.Y) > 3 then wasDragged = true end
			toggleButton.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
		end
	end)
	self._OnDragStart = onDragStart
	self._OnDragEnd = onDragEnd
	return self
end

